# Production environment configuration
# DO NOT commit actual secrets to git!
# These values should come from your secret management system:
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
# - GCP Secret Manager
# - Kubernetes Secrets
# - Docker Secrets
# - etc.

# Generate strong JWT secret (min 32 chars, use random bytes)
# Command: openssl rand -base64 32
JWT_SECRET=your generated 32 character code (as i changed it to proper 32 char secret not dummy like previous which i push in git 😂)

# PostgreSQL production URL with strong credentials
# Format: user=username password=strongpass dbname=appname host=prod-db.example.com port=5432 sslmode=require
DATABASE_URL=user=userName password=yourpassword dbname=dbName host=localhost port=portNo sslmode=disable

# Redis production address with authentication
# Consider using Redis Cluster for HA
# Format: host:port with password in URL
REDIS_ADDR=prod-redis.example.com:6379

# Always use production in production environment
ENVIRONMENT=production

# Optional: Add these for enhanced security
# LOG_LEVEL=info  # Change from debug to minimize log verbosity
# REQUEST_TIMEOUT=30s
# DB_SSL_CERT=/etc/ssl/certs/prod-ca.pem
